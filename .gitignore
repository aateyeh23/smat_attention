# The paper itself lives elsewhere; this repo is the code and the numbers.
paper_drafts/

# Job output.  Machine-generated and regenerated on every run -- but keep
# logs/README.md, which is the write-up of the three kernel defects the smoke
# runs caught and is not recoverable from a rerun.

slurm-*.out
smoke-*.out

# The dark-mode rendering of the tracked figures: same panels, same CSVs,
# regenerated with `plot_smat.py --dark`.
figures_dark/

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store

# Cluster job logs: verbose per-step output, regenerable; the CSVs in
# the GPU cluster/results are the record.
the GPU cluster/logs/**/*.out
/logs/*.out

# Local cluster settings: partition, account, module loads.  Never committed.
site.conf

# Datasets and caches
data/
zoology_cache/

# Checkpoints and per-run scratch under results/: the CSV and JSON are the record
results/**/*.pt
results/**/*.tmp
results/**/*.log
results/**/*.out
results/**/check_cache/
results/**/cache-*/

# Legacy experiment folders retained for reproducible source snapshots.
# The paper itself lives elsewhere; this repo is the code and the numbers.
paper_drafts/

