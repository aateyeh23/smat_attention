# The paper itself lives elsewhere; this repo is the code and the numbers.
paper_drafts/

# Job output.  Machine-generated and regenerated on every run.

slurm-*.out
smoke-*.out

# The dark-mode rendering of the tracked figures: same panels, same CSVs,
# regenerated with `--dark` on the analysis/fig_*.py scripts.
figures_dark/

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store

# Cluster job logs: verbose per-step output, regenerable; the CSVs are the record.
/logs/

# Local cluster settings: partition, account, module loads.  Never committed.
site.conf

# Datasets and caches (the top-level data directory only: tasks/data/ holds prep scripts)
/data/
zoology_cache/

# Checkpoints and per-run scratch under results/: the CSV and JSON are the record
results/**/*.pt
results/**/*.tmp
results/**/*.log
results/**/*.out
results/**/check_cache/
results/**/cache-*/
results/**/*.npz
results/**/*.npy
results/**/*.partial
results/**/*.lock
results/**/*.tar.gz

# Compiler caches written by the GPU jobs
.triton-cache/
triton_cache/
