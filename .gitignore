# The paper itself lives elsewhere; this repo is the code and the numbers.
paper_drafts/

# Job output.  Machine-generated and regenerated on every run -- but keep
# logs/README.md, which is the write-up of the three kernel defects the smoke
# runs caught and is not recoverable from a rerun.
smat/logs/*.out
smat/logs/*.log
slurm-*.out
smoke-*.out

# The dark-mode rendering of the tracked figures: same panels, same CSVs,
# regenerated with `plot_smat.py --dark`.
smat/figs_dark/

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store

# DeltaAI/SCF job logs: verbose per-step output, regenerable; the CSVs in
